# Keep full source assets and generated working files out of Git.
*.zip
*.blend
*.fbx
*.png
*.jpg
*.pdf

# Audited release update parts and review PDFs are deliberately tracked.
!updates/20261013/**/*.zip
!atlas/20261013/*.pdf

# Reviewed cloud candidates; keep baseline reconstruction unchanged.
!candidates/20261118/**/*.zip
!candidates/20261118/**/*.zip.part*
!candidates/20261118/previews/*.jpg
!candidates/20261120-cloud/previews/*.jpg

# Local-only generated artifacts; do not hide audit JSON or release dependencies.
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
/.local-work/
/.local-cache/
